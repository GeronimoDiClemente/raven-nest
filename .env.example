VITE_SUPABASE_URL=your_value_here
VITE_SUPABASE_ANON_KEY=your_value_here
VITE_STRIPE_PUBLISHABLE_KEY=your_value_here
MAIN_VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
MAIN_VITE_SLACK_CLIENT_ID=your_slack_oauth_client_id
MAIN_VITE_SLACK_CLIENT_SECRET=your_slack_oauth_client_secret
# Nest Memory (docs/nest-memory-architecture.md) — same value as VITE_SUPABASE_URL above,
# mirrored under MAIN_VITE_ so electron-vite exposes it to the main process (the sync
# daemon calls memory-sync directly over HTTPS, not through the renderer's JS client).
MAIN_VITE_SUPABASE_URL=your_value_here
