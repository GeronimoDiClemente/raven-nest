     expect(calls).toEqual(['disconnect', 'revoke'])
   })
 })
+
+// ---- Bug 3.4 (MEMORY_INTEGRATIONS_CONTRACT §3) ----
+// `window.memory` is a preload API, and useMemory called it unguarded on mount
+// (status() and onStatus()). Anywhere the preload hasn't exposed it — an old preload
+// after a partial update, a render outside Electron, a test harness that doesn't know
+// about it — the hook threw and took the whole Settings panel down with it. main.ts
+// already treats the memory subsystem as something that can fail and degrade; the hook
+// is the piece that didn't.
+describe('useMemory when the preload never exposed window.memory', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    delete (globalThis as unknown as { window: { memory?: unknown } }).window.memory
+  })
+
+  it('reports memory as unavailable instead of throwing on mount', () => {
+    const { result } = renderHook(() => useMemory())
+
+    expect(result.current.state).toBe('unavailable')
+  })
+
+  it('unmounts cleanly without calling into the missing API', () => {
+    const { unmount } = renderHook(() => useMemory())
+
+    expect(() => unmount()).not.toThrow()
+  })
+
+  it('stays unavailable — connect() cannot reach the backend, so it must not try', async () => {
+    const { result } = renderHook(() => useMemory())
+
+    await act(async () => {
+      await result.current.connect()
+    })
+
+    expect(supabaseMock.functions.invoke).not.toHaveBeenCalled()
+    expect(result.current.state).toBe('unavailable')
+  })
+
+  it('stays unavailable — disconnect() is a no-op rather than a crash', async () => {
+    const { result } = renderHook(() => useMemory())
+
+    await act(async () => {
+      await result.current.disconnect(true)
+    })
+
+    expect(supabaseMock.functions.invoke).not.toHaveBeenCalled()
+    expect(result.current.state).toBe('unavailable')
+  })
+})
