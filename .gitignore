node_modules/
dist/
dist-electron/
*.local
.env
.env.*
!.env.example
# El scratch de superpowers no se versiona. La excepcion de las capturas vive
# en `.superpowers/sdd/.gitignore`, al lado de lo que regula.
.superpowers/*
!.superpowers/sdd/
.worktrees/
*.tsbuildinfo
*.log

# Personal scratchpads and internal notes — kept locally, not published
SESSION.md
# El scratch de superpowers no se versiona, PERO specs y plans si: son
# deliverables que el equipo lee. 29 specs y 43 plans ya estaban trackeados a
# la fuerza con `git add -f` porque la regla decia `docs/superpowers/` entero.
# Va sobre el CONTENIDO (`/*`), no sobre el directorio: git no aplica una
# negacion a algo que esta adentro de un directorio excluido, asi que con
# `docs/superpowers/` los `!` de abajo no tendrian ningun efecto.
docs/superpowers/*
!docs/superpowers/specs/
!docs/superpowers/plans/

# macOS noise
.DS_Store

# Playwright E2E
test-results/
playwright-report/
e2e/.auth/

# Supabase CLI generated state
supabase/.temp/

# Local scratch scripts / accidental folders
Microsoft/
stress-cpu.js

# Local seed/check helpers (contain service_role key, never commit)
_seed-*.mjs
_check-*.mjs

# Claude Code scheduled tasks (local-only)
.claude/scheduled_tasks.lock

# tweakcn live-preview del workspace (dev-only: carga script externo de
# tweakcn.com y NO debe ir a producción; se sirve en localhost:5173/theme-preview.html)
src/public/theme-preview.html

# Worktrees locales de Nest y salidas binarias de las capturas: no van al repo.
.claude/worktrees/
capture/*.mp4
capture/*.png
capture/f/
capture/rec/
capture/stats-rec/

# El build del paquete portátil (se genera con `npm run build` adentro de packages/nest-memory)
packages/nest-memory/dist/
